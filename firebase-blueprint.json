{
  "entities": {
    "vessel": {
      "title": "Vessel",
      "description": "Shipping vessel or ship in the fleet",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100, "description": "Nama kapal" },
        "imoNumber": { "type": "string", "minLength": 7, "maxLength": 12, "description": "Nomor IMO kapal" },
        "type": { "type": "string", "enum": ["Container", "Bulk Carrier", "Tanker", "Ro-Ro", "General Cargo"], "description": "Jenis kapal" },
        "capacityDwt": { "type": "number", "description": "Deadweight Tonnage (DWT)" },
        "capacityTeu": { "type": "number", "description": "Twenty-foot Equivalent Unit (TEU)" },
        "status": { "type": "string", "enum": ["Sailing", "Berthed", "Anchored", "Maintenance"], "description": "Status operasional" },
        "flag": { "type": "string", "maxLength": 50, "description": "Bendera kebangsaan kapal" },
        "yearBuilt": { "type": "number", "description": "Tahun pembuatan kapal" },
        "currentPort": { "type": "string", "maxLength": 100, "description": "Pelabuhan saat ini" },
        "destinationPort": { "type": "string", "maxLength": 100, "description": "Pelabuhan tujuan" },
        "speedKnots": { "type": "number", "description": "Kecepatan kapal dalam knot" },
        "fuelConsumptionTonsPerDay": { "type": "number", "description": "Konsumsi bahan bakar per hari" },
        "createdAt": { "type": "string", "description": "Timestamp pembuatan data" },
        "updatedAt": { "type": "string", "description": "Timestamp pembaharuan data" }
      },
      "required": ["name", "imoNumber", "type", "capacityDwt", "status"]
    },
    "voyage": {
      "title": "Voyage",
      "description": "Voyage schedule for a vessel between ports",
      "type": "object",
      "properties": {
        "voyageNumber": { "type": "string", "minLength": 3, "maxLength": 50, "description": "Kode pelayaran" },
        "vesselId": { "type": "string", "maxLength": 100, "description": "ID kapal" },
        "vesselName": { "type": "string", "maxLength": 100, "description": "Nama kapal" },
        "originPort": { "type": "string", "minLength": 2, "maxLength": 100, "description": "Pelabuhan keberangkatan" },
        "destinationPort": { "type": "string", "minLength": 2, "maxLength": 100, "description": "Pelabuhan tujuan" },
        "departureDate": { "type": "string", "description": "Estimasi tanggal keberangkatan (ETD)" },
        "arrivalDate": { "type": "string", "description": "Estimasi tanggal kedatangan (ETA)" },
        "distanceNm": { "type": "number", "description": "Jarak pelayaran dalam mil laut" },
        "status": { "type": "string", "enum": ["Scheduled", "In Transit", "Arrived", "Completed", "Delayed"], "description": "Status perjalanan" },
        "cargoTonnes": { "type": "number", "description": "Total tonase kargo" },
        "notes": { "type": "string", "maxLength": 500, "description": "Catatan navigasi" },
        "createdAt": { "type": "string", "description": "Timestamp pembuatan" },
        "updatedAt": { "type": "string", "description": "Timestamp pembaruan" }
      },
      "required": ["voyageNumber", "vesselName", "originPort", "destinationPort", "departureDate", "arrivalDate", "status"]
    },
    "cargo": {
      "title": "Cargo",
      "description": "Cargo shipment manifest and bill of lading",
      "type": "object",
      "properties": {
        "billOfLading": { "type": "string", "minLength": 4, "maxLength": 50, "description": "Nomor B/L" },
        "voyageNumber": { "type": "string", "maxLength": 50, "description": "Nomor pelayaran terkait" },
        "vesselName": { "type": "string", "maxLength": 100, "description": "Nama kapal pengangkut" },
        "shipper": { "type": "string", "minLength": 2, "maxLength": 120, "description": "Nama pihak pengirim" },
        "consignee": { "type": "string", "minLength": 2, "maxLength": 120, "description": "Nama pihak penerima" },
        "cargoType": { "type": "string", "enum": ["Dry Container", "Reefer Container", "Liquid Bulk", "Dry Bulk", "General Cargo", "Heavy Equipment"], "description": "Tipe muatan" },
        "quantity": { "type": "number", "description": "Jumlah unit atau kontainer" },
        "weightTons": { "type": "number", "description": "Berat kargo dalam ton" },
        "volumeCbm": { "type": "number", "description": "Volume kargo dalam CBM" },
        "status": { "type": "string", "enum": ["Pending Loading", "Loaded", "In Transit", "Discharged", "Delivered"], "description": "Status kargo" },
        "hazardous": { "type": "boolean", "description": "Apakah muatan berbahaya (DG)" },
        "specialInstructions": { "type": "string", "maxLength": 300, "description": "Instruksi penanganan khusus" },
        "createdAt": { "type": "string", "description": "Timestamp pembuatan" },
        "updatedAt": { "type": "string", "description": "Timestamp pembaruan" }
      },
      "required": ["billOfLading", "shipper", "consignee", "cargoType", "quantity", "weightTons", "status"]
    },
    "crew": {
      "title": "Crew",
      "description": "Ship crew member and maritime officer profile",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100, "description": "Nama lengkap pelaut" },
        "seamanBookNo": { "type": "string", "minLength": 4, "maxLength": 40, "description": "Nomor Buku Pelaut" },
        "rank": { "type": "string", "enum": ["Nakhoda (Master)", "Mualim I (Chief Officer)", "Mualim II", "Kepala Kamar Mesin (Chief Engineer)", "Masinis II", "Bosun", "Juru Mudi (AB)", "Oiler"], "description": "Pangkat maritim" },
        "assignedVessel": { "type": "string", "maxLength": 100, "description": "Kapal tugas saat ini" },
        "status": { "type": "string", "enum": ["On Duty", "On Leave", "Standby"], "description": "Status ketersediaan" },
        "certificateExpiry": { "type": "string", "description": "Tanggal kedaluwarsa sertifikat STCW" },
        "contactPhone": { "type": "string", "maxLength": 30, "description": "Nomor telepon kontak darurat" },
        "createdAt": { "type": "string", "description": "Timestamp pembuatan" },
        "updatedAt": { "type": "string", "description": "Timestamp pembaruan" }
      },
      "required": ["fullName", "seamanBookNo", "rank", "status"]
    }
  },
  "firestore": {
    "/vessels/{vesselId}": {
      "schema": "vessel",
      "description": "Armada kapal perusahaan pelayaran"
    },
    "/voyages/{voyageId}": {
      "schema": "voyage",
      "description": "Jadwal dan rute pelayaran kapal"
    },
    "/cargo/{cargoId}": {
      "schema": "cargo",
      "description": "Manifest muatan dan kargo kapal"
    },
    "/crew/{crewId}": {
      "schema": "crew",
      "description": "Data awak kapal dan kru pelaut"
    }
  }
}
